{
  "manifest_version": 3,
  "name": "Great Wall of Doom",
  "version": "0.1.0",
  "description": "Block doom-scrolling sections across social media sites.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": [
        "sites/tiktok/config.js",
        "sites/tiktok/ui.js",
        "sites/tiktok/navigation.js"
      ],
      "css": ["sites/tiktok/style.css"],
      "run_at": "document_start"
    }
  ]
}
